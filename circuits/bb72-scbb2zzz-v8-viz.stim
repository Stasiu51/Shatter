# Shatter overlay. Blocks stacked top to bottom, reference ancillas below.
# data = gold/orange, X check = lightcoral, Z check = cornflowerblue, reference = violet.
# 3 blocks: surface (36d+35a), bb (72d+72a), bb (72d+72a) with 12 stitching gauges.
##! SHEET NAME=QUBITS Z=0
##! SHEET NAME=CHECKS Z=1
##! SHEET NAME=STITCH Z=2
##! SHEET NAME=LOGICAL Z=3
##! SHEET NAME=CROSSZ Z=4
##! SHEET NAME=PRODUCTS Z=5
##! TIMESTEP INDEX=0 LABEL="opening projections: block stabilisers and reference Bell operators" BOOKMARK=TRUE
